def p_tres():
    n = int(input("3. Ingrese numero o cod estudiante: "))
    fibo = 0
    fibo2 = 1
    while fibo2 < n:
        sec = fibo + fibo2
        fibo = fibo2
        fibo2 = sec
    if n == fibo2 or n == 0:
        print(n, "si hace parte de la Sucesión de Fibonacci")
    else:
        print(n, "no hace parte de la Sucesión de Fibonacci")
